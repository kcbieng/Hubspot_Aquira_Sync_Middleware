# Paste these into the Portainer stack environment editor. Do not commit a filled copy.

POSTGRES_DB=aquira_hubspot
POSTGRES_USER=middleware
POSTGRES_PASSWORD=change-me-strong-password
MIDDLEWARE_PORT=8080

AQUIRA_BASE_URL=https://aquira2go.kcbieng.org/Aquira_WebAPI
AQUIRA_USERNAME=
AQUIRA_PASSWORD=

HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_SECRET=
AQUIRA_WEBHOOK_SECRET=

# Must use the same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql://middleware:change-me-strong-password@db:5432/aquira_hubspot

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_FERNET_KEY=

# Public URL HubSpot uses for webhook signature checks, e.g. https://sync.example.com
PUBLIC_BASE_URL=

UI_USERNAME=admin
UI_PASSWORD=change-me-admin-password

SYNC_INTERVAL_MINUTES=30
WHATIF=true
SYNC_CALLS=false
SYNC_CREATE_AQUIRA_CLIENT=true
BOOTSTRAP_HUBSPOT=true
AQUIRA_TEAM_ATTRIBUTE=HubSpot Team
LOG_LEVEL=INFO
ENVIRONMENT=production
APP_NAME=HubQuira
