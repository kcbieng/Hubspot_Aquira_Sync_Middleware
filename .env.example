AQUIRA_BASE_URL=https://aquira2go.kcbieng.org/Aquira_WebAPI
AQUIRA_USERNAME=
AQUIRA_PASSWORD=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_SECRET=
AQUIRA_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
DATABASE_URL=postgresql://middleware:middleware_password@db:5432/aquira_hubspot
SETTINGS_FERNET_KEY=
UI_USERNAME=admin
UI_PASSWORD=admin
SYNC_INTERVAL_MINUTES=30
WHATIF=true
SYNC_CALLS=false
SYNC_CREATE_AQUIRA_CLIENT=true
LOG_LEVEL=INFO
BOOTSTRAP_HUBSPOT=true
AQUIRA_TEAM_ATTRIBUTE=HubSpot Team
ENVIRONMENT=development
APP_NAME=HubQuira
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MATCH_DIGEST_ENABLED=true
SSO_ENABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SSO_ADMIN_GROUP=
SSO_SALES_GROUP=
TEAMS_WEBHOOK_URL=
# Deal-stage mapping (custom HubSpot pipelines). Leave all four blank to keep
# the legacy behavior (default pipeline, built-in stage tokens). A custom
# pipeline needs the pipeline id AND all three stage ids (use /ui/stages ->
# Autodetect). /ui/stages also writes these to the settings DB, which wins
# over these env values at boot.
HUBSPOT_DEAL_PIPELINE=
HUBSPOT_STAGE_PROPOSAL=
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=
# Dead-letter reconciliation cadence + first backoff step (minutes, floor 5)
# and retry budget (cycles before a row is held for human review, floor 2).
DLQ_RETRY_MINUTES=45
DLQ_FREEZE_AFTER=5
